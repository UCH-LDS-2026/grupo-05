{
  "expo": {
    "name": "Spot",
    "slug": "spot",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "spot",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permití usar la cámara para escanear QR de canjes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
