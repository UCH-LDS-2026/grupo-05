# Copiá este archivo a ".env" en esta misma carpeta (src/apps/api/.env)
# y ajustá si hace falta.

# Conexión a Postgres (debe coincidir con docker-compose.yml de la raíz).
DATABASE_URL="postgresql://spot:spot_dev_pw@localhost:5433/spot?schema=public"

# Clave para firmar los JWT (en dev podés dejar esta; en prod usá una random larga).
JWT_SECRET="dev-secret-spot-mvp-no-usar-en-prod-1a2b3c4d5e6f7g8h"
JWT_EXPIRES_IN="7d"

# Puerto del backend.
API_PORT=3001
